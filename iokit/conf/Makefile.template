# Rebuild if per-file overrides change
${OBJS}: $(firstword $(MAKEFILE_LIST))

# Rebuild if global compile flags change
$(COBJS): .CFLAGS
.CFLAGS: ALWAYS
	$(_v)$(REPLACECONTENTS) $@ $(KCC) $(CFLAGS) $(INCFLAGS)
$(CXXOBJS): .CXXFLAGS
.CXXFLAGS: ALWAYS
	$(_v)$(REPLACECONTENTS) $@ $(KC++) $(CXXFLAGS) $(INCFLAGS)
$(SOBJS): .SFLAGS
.SFLAGS: ALWAYS
	$(_v)$(REPLACECONTENTS) $@ $(S_KCC) $(SFLAGS) $(INCFLAGS)

$(COMPONENT).filelist: $(OBJS)
	$(_v)for hib_file in ${HIB_FILES};		\
	do	\
                $(SEG_HACK) -n __HIB -o $${hib_file}__ $${hib_file} || exit 1; \
                mv $${hib_file}__ $${hib_file} || exit 1; \
	done
	@$(LOG_LDFILELIST) "$(COMPONENT)"
	$(_v)for obj in ${OBJS}; do	\
		 $(ECHO) $(TARGET)/$(CURRENT_KERNEL_CONFIG)/$${obj}; \
	done > $(COMPONENT).filelist

$(COMPONENT).libfilelist: $(LIBOBJS)
	@$(LOG_LDFILELIST) "lib$(COMPONENT)"
	$(_v)for obj in ${LIBOBJS}; do	\
		 $(ECHO) $(TARGET)/$(CURRENT_KERNEL_CONFIG)/$${obj}; \
	done > $(COMPONENT).libfilelist

ifeq ($(RC_ProjectName),xnu_libraries)
do_all: $(COMPONENT).libfilelist
else
do_all: $(COMPONENT).filelist
endif

do_build_all:: do_all

# BEGIN IOGraphics per-object flags -- generated by tools/vendor_iographics_into_xnu.sh, do not edit
#
# GTRACE_IMPL: Apple's IOGraphics.xcodeproj defines it in all three
# IOGraphicsFamily configs (project.pbxproj:2140,2207,2262). The -include'd
# headers and the extra -I dirs: see tools/vendor_iographics_into_xnu.sh.
IOGRAPHICS_OBJS = IOBacklightDisplay.cpo IOBootFramebuffer.cpo IODisplay.cpo IODisplayWrangler.cpo IODisplayWranglerUserClients.cpo IOFramebuffer.cpo IOFramebufferUserClient.cpo IOGraphicsDevice.cpo IOI2CInterface.cpo GMetric.cpo GTrace.cpo osmemory.cpo
IOGRAPHICS_CFLAGS = -DGTRACE_IMPL \
	-include $(SRCROOT)/iokit/Graphics/compat/IOGraphicsTypesPrivateMissing.h \
	-include $(SRCROOT)/iokit/Graphics/compat/IOBacklightDisplayTraceMissing.h
IOGRAPHICS_INCFLAGS = -I$(SRCROOT)/iokit/Graphics \
	-I$(SRCROOT)/iokit/Graphics/IOGraphicsFamily \
	-I$(SRCROOT)/iokit/Graphics/GMetric \
	-I$(SRCROOT)/iokit/Graphics/GTrace/Kernel \
	-I$(SRCROOT)/iokit/IOKit/graphics/tl \
	-I$(SRCROOT)/iokit/Graphics/xxhash
$(foreach o,$(IOGRAPHICS_OBJS),$(eval $(o)_CFLAGS_ADD += $(IOGRAPHICS_CFLAGS) $(IOGRAPHICS_INCFLAGS)))
#
# LZVN (C objects, so .o): lzfse's state decoder is renamed so the
# 4-argument lzvn_decode() IOGraphics calls can exist; see
# iokit/Graphics/lzvn/IOGraphicsLZVN.c.
LZVN_OBJS = lzvn_decode_base.o IOGraphicsLZVN.o
LZVN_CFLAGS = -Dlzvn_decode=lzfse_lzvn_decode_state \
	-I$(SRCROOT)/iokit/Graphics/lzvn \
	-I$(SRCROOT)/iokit/Graphics/lzvn/kernel_compat
$(foreach o,$(LZVN_OBJS),$(eval $(o)_CFLAGS_ADD += $(LZVN_CFLAGS)))
# END IOGraphics per-object flags

